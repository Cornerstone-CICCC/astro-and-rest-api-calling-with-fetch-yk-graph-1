---
import Layout from '@/layouts/Layout.astro';
import type { Post } from '@/types';
import { API_URL } from '@/constants';

export async function getStaticPaths() {
  const response = await fetch(`${API_URL}/posts`);
  const posts: Post[] = await response.json();

  return posts.map((post) => ({
    params: { id: String(post.id) },
  }));
}

const { id } = Astro.params;

let post: Post | null = null;
let error: string | null = null;

try {
  const response = await fetch(`${API_URL}/posts/${id}`);

  if (!response.ok) {
    throw new Error(`API Error: ${response.status} ${response.statusText}`);
  }

  post = await response.json();
} catch (error) {
  error = error instanceof Error ? error.message : 'An unknown error occurred';
  console.error('Data fetching error:', error);
}
---

<Layout>
  <div class="w-2/5">
    <div class="w-full flex justify-between items-center mb-4">
      <a href="/" class="inline-block text-sm text-stone-400">◀ Back to list</a>
      {post &&
        <button id="delete-btn" data-post-id={post.id} data-api-url={API_URL} class="text-sm bg-red-900 text-white px-4 py-2 rounded cursor-pointer hover:bg-red-800 disabled:opacity-50 disabled:cursor-not-allowed">
          Delete
        </button>
      }
    </div>

    <div id="status-message" class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded" role="alert"></div>
    <div id="error-message" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert"></div>

    {error ? (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded" role="alert">
        <h2 class="font-bold">An error occurred</h2>
        <p>{error}</p>
      </div>
    ) : post ? (
      <article class="border border-white rounded p-6">
        <p class="text-sm text-stone-400 mb-2">Post ID: {post.id} / User ID: {post.userId}</p>
        <h1 class="text-2xl font-bold mb-4">{post.title}</h1>
        <p class="leading-relaxed">{post.body}</p>
      </article>
    ) : null}
  </div>
</Layout>

<script>
  import { sleep } from '@/utils';

  const btn = document.querySelector<HTMLButtonElement>('#delete-btn');
  const errorDiv = document.querySelector<HTMLDivElement>('#error-message');
  const statusDiv = document.querySelector<HTMLDivElement>('#status-message');

  btn?.addEventListener('click', async () => {
    const postId = btn.dataset.postId;
    const apiUrl = btn.dataset.apiUrl;

    if (!confirm('Are you sure you want to delete this post?')) return;

    btn.disabled = true;

    try {
      const response = await fetch(`${apiUrl}/posts/${postId}`, {
        method: 'DELETE',
      });

      if (!response.ok) {
        throw new Error(`API Error: ${response.status} ${response.statusText}`);
      }

      if (statusDiv) {
        statusDiv.textContent = 'Post deleted successfully.';
        statusDiv.classList.remove('hidden');
      }

      await sleep(3000);

      window.location.href = '/';
    } catch (error) {
      const message = error instanceof Error ? error.message : 'An unknown error occurred';

      if (errorDiv) {
        errorDiv.textContent = `Failed to delete: ${message}`;
        errorDiv.classList.remove('hidden');
      }
    } finally {
      btn.disabled = false;
    }
  });
</script>
